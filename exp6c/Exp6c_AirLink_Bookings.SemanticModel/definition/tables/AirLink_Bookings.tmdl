	partition AirLink_Bookings = m
		mode: import
		source =
				let
				    // Looks for the dataset in the usual places. If you keep it somewhere
				    // else, add that full path to this list - nothing else needs changing.
				    Candidates = {
				        "D:\DVT\6a to 7b\DVT\exp6c\airlink_bookings_raw.csv",
				        "C:\DVT\exp6c\airlink_bookings_raw.csv",
				        "D:\DVT\exp6c\airlink_bookings_raw.csv",
				        "C:\DVT\DVT\exp6c\airlink_bookings_raw.csv",
				        "D:\DVT\DVT\exp6c\airlink_bookings_raw.csv",
				        "E:\DVT\exp6c\airlink_bookings_raw.csv",
				        "E:\DVT\DVT\exp6c\airlink_bookings_raw.csv"
				    },
				    Existing = List.Select(Candidates, each
				        try Binary.Length(File.Contents(_)) > 0 otherwise false),
				    DataFile = List.First(Existing, null),
				    Located = if DataFile = null then error "Could not find airlink_bookings_raw.csv. Open Transform Data and add its full path to the Candidates list in this query." else DataFile,
				    Source = Csv.Document(File.Contents(Located),[Delimiter=",", Columns=19, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Removed Duplicates" = Table.Distinct(#"Promoted Headers"),
				    #"Removed Corporate Account" = Table.RemoveColumns(#"Removed Duplicates",
				        {"corporate_account"}),
				    #"Cleaned Children" = Table.TransformColumns(#"Removed Corporate Account",
				        {{"children", each if _ = null or _ = "" or _ = "NA" then 0 else Number.From(_), Int64.Type}}),
				    #"Cleaned Fare" = Table.TransformColumns(#"Cleaned Children",
				        {{"fare", each if _ = null or _ = "" or _ = "NA" then 0 else Number.From(_), type number}}),
				    #"Cleaned Country" = Table.TransformColumns(#"Cleaned Fare",
				        {{"country", each if _ = null or _ = "" then "IND" else _, type text}}),
				    #"Cleaned Agent" = Table.TransformColumns(#"Cleaned Country",
				        {{"agent", each if _ = null or _ = "" then 0 else Number.From(_), Int64.Type}}),
				    #"Added Month Number" = Table.AddColumn(#"Cleaned Agent", "travel_month_no", each
				        List.PositionOf({"January","February","March","April","May","June","July","August","September","October","November","December"}, [travel_month]) + 1, Int64.Type),
				    #"Added Travel Period" = Table.AddColumn(#"Added Month Number", "travel_period", each
				        #date(Number.From([travel_year]), [travel_month_no], 1), type date),
				    #"Added Lead Band" = Table.AddColumn(#"Added Travel Period", "lead_time_band", each
				        let d = Number.From([lead_time]) in
				        if d <= 7 then "0-7 days"
				        else if d <= 30 then "8-30 days"
				        else if d <= 90 then "31-90 days"
				        else if d <= 180 then "91-180 days"
				        else "180+ days", type text),
				    #"Added Band Number" = Table.AddColumn(#"Added Lead Band", "lead_band_no", each
				        let d = Number.From([lead_time]) in
				        if d <= 7 then 1 else if d <= 30 then 2 else if d <= 90 then 3
				        else if d <= 180 then 4 else 5, Int64.Type),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Band Number",{{"booking_id", type text}, {"airline", type text}, {"travel_year", Int64.Type}, {"travel_month", type text}, {"travel_month_no", Int64.Type}, {"travel_period", type date}, {"lead_time", Int64.Type}, {"lead_time_band", type text}, {"lead_band_no", Int64.Type}, {"adults", Int64.Type}, {"children", Int64.Type}, {"infants", Int64.Type}, {"country", type text}, {"agent", Int64.Type}, {"cabin_class", type text}, {"fare", type number}, {"is_cancelled", Int64.Type}, {"booking_channel", type text}, {"reservation_status", type text}, {"reservation_status_date", type date}, {"checked_bags", Int64.Type}, {"seat_changes", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

