table AirLink_Bookings
	lineageTag: d79d12e4-5396-32f4-cc44-da7e88ca99b4

	measure 'Total Bookings' = COUNTROWS('AirLink_Bookings')
		formatString: #,0
		lineageTag: ecbbd4fe-086c-e57d-08a2-4eb8afc7886f

	measure 'Cancelled Bookings' = SUM('AirLink_Bookings'[is_cancelled])
		formatString: #,0
		lineageTag: 5cb0ba74-2622-1327-a8c1-7ba1b925e589

	measure 'Cancellation Rate' = DIVIDE([Cancelled Bookings], [Total Bookings])
		formatString: 0.0%
		lineageTag: f87abea7-ef62-a186-793d-523df982cee0

	measure 'Average Lead Time' = AVERAGE('AirLink_Bookings'[lead_time])
		formatString: #,0.0
		lineageTag: 61879b66-44b1-fed1-eb9d-e13cd9fc63a8

	measure 'Average Fare' = AVERAGE('AirLink_Bookings'[fare])
		formatString: \₹#,0
		lineageTag: 9eae1273-7431-23b1-5ece-8534f2f2bf87

	measure 'Total Fare Revenue' = CALCULATE(SUM('AirLink_Bookings'[fare]), 'AirLink_Bookings'[is_cancelled] = 0)
		formatString: \₹#,0
		lineageTag: 58b96e28-a6b9-96a5-6e34-0611259abb67

