          {
            "name": "Season",
            "dataType": "string",
            "sourceColumn": "Season",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "FinancialYear",
            "dataType": "string",
            "sourceColumn": "FinancialYear",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "IsPeakSeason",
            "dataType": "boolean",
            "sourceColumn": "IsPeakSeason",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Season Sort",
            "dataType": "int64",
            "expression": "SWITCH( DimDate[Season], \"Winter\", 1, \"Summer\", 2, \"Monsoon\", 3, \"Autumn\", 4, 5 )",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "0"
          },
          {
            "type": "calculated",
            "name": "Peak Season Label",
            "dataType": "string",
            "expression": "IF ( DimDate[IsPeakSeason], \"Peak Season\", \"Off Peak\" )",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Year Quarter",
            "dataType": "string",
            "expression": "DimDate[Year] & \"-\" & DimDate[Quarter]",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "DimDate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(ServerName, DatabaseName),",
                "    dbo_DimDate = Source{[Schema=\"dbo\",Item=\"DimDate\"]}[Data],",
                "    #\"Changed Type\" = Table.TransformColumnTypes(dbo_DimDate,{{\"FullDate\", type date}}),",
                "    #\"Sorted Rows\" = Table.Sort(#\"Changed Type\",{{\"DateKey\", Order.Ascending}})",
                "in",
                "    #\"Sorted Rows\""
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Calendar Hierarchy",
            "levels": [
              {
                "name": "Year",
                "ordinal": 0,
                "column": "Year"
              },
              {
                "name": "Quarter",
                "ordinal": 1,
                "column": "Quarter"
              },
              {
                "name": "MonthName",
                "ordinal": 2,
                "column": "MonthName"
              }
            ]
          }
        ],
        "dataCategory": "Time",
        "description": "Conformed calendar dimension. Marked as the model date table for time intelligence.",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_MarkedDateTable",
            "value": "true"
          }
        ]
      },
