            "dataType": "double",
            "sourceColumn": "DiscountPct",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "0.0%"
          },
          {
            "name": "TravellerDays",
            "dataType": "int64",
            "sourceColumn": "TravellerDays",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "#,0"
          },
          {
            "type": "calculated",
            "name": "Trip Value Category",
            "dataType": "string",
            "expression": "SWITCH ( TRUE(),\n    FactTrip[Revenue] >= 600000, \"1. Premium (6L+)\",\n    FactTrip[Revenue] >= 300000, \"2. High (3-6L)\",\n    FactTrip[Revenue] >= 150000, \"3. Mid (1.5-3L)\",\n    \"4. Entry (<1.5L)\" )",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Is Cancelled",
            "dataType": "int64",
            "expression": "IF ( FactTrip[BookingStatus] = \"Cancelled\", 1, 0 )",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "0"
          },
          {
            "type": "calculated",
            "name": "Trip Margin",
            "dataType": "decimal",
            "expression": "FactTrip[NetRevenue] - FactTrip[AccommodationCost] * 0.72 - FactTrip[TransportCost] * 0.88 - FactTrip[ActivityCost] * 0.55",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "\"₹\"#,0",
            "description": "Estimated gross margin after supplier cost of sale."
          }
        ],
        "partitions": [
          {
            "name": "FactTrip",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(ServerName, DatabaseName),",
                "    dbo_FactTrip = Source{[Schema=\"dbo\",Item=\"FactTrip\"]}[Data],",
                "    #\"Removed Blank Rows\" = Table.SelectRows(dbo_FactTrip, each [TripID] <> null and [Revenue] <> null),",
                "    #\"Filtered Valid Trips\" = Table.SelectRows(#\"Removed Blank Rows\", each [DurationDays] > 0 and [NumTravellers] > 0 and [Revenue] > 0),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Filtered Valid Trips\",{{\"Revenue\", type number}, {\"NetRevenue\", type number}, {\"GrossAmount\", type number}, {\"DiscountAmount\", type number}, {\"SatisfactionScore\", type number}}),",
                "    #\"Added Satisfaction Band\" = Table.AddColumn(#\"Changed Type\", \"Satisfaction Band\", each if [SatisfactionScore] = null then \"Not Rated\" else if [SatisfactionScore] >= 8 then \"Promoter (8-10)\" else if [SatisfactionScore] >= 6 then \"Passive (6-7.9)\" else \"Detractor (<6)\", type text),",
                "    #\"Added Discount Pct\" = Table.AddColumn(#\"Added Satisfaction Band\", \"DiscountPct\", each if [GrossAmount] = 0 then 0 else [DiscountAmount] / [GrossAmount], type number),",
                "    #\"Added Traveller Days\" = Table.AddColumn(#\"Added Discount Pct\", \"TravellerDays\", each [NumTravellers] * [DurationDays], Int64.Type)",
                "in",
                "    #\"Added Traveller Days\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Bookings",
            "expression": "COUNTROWS ( FactTrip )",
            "formatString": "#,0",
            "displayFolder": "01 Volume"
          },
          {
            "name": "Total Travellers",
            "expression": "SUM ( FactTrip[NumTravellers] )",
            "formatString": "#,0",
            "displayFolder": "01 Volume"
          },
          {
            "name": "Traveller Days",
            "expression": "SUM ( FactTrip[TravellerDays] )",
            "formatString": "#,0",
            "displayFolder": "01 Volume"
          },
          {
            "name": "Distinct Travellers",
            "expression": "DISTINCTCOUNT ( FactTrip[TravellerID] )",
            "formatString": "#,0",
            "displayFolder": "01 Volume"
          },
          {
            "name": "Distinct Destinations",
            "expression": "DISTINCTCOUNT ( FactTrip[DestinationID] )",
            "formatString": "#,0",
            "displayFolder": "01 Volume"
          },
          {
            "name": "Completed Bookings",
            "expression": "CALCULATE ( [Total Bookings], FactTrip[BookingStatus] = \"Completed\" )",
            "formatString": "#,0",
            "displayFolder": "01 Volume"
          },
          {
            "name": "Cancelled Bookings",
            "expression": "CALCULATE ( [Total Bookings], FactTrip[BookingStatus] = \"Cancelled\" )",
            "formatString": "#,0",
            "displayFolder": "01 Volume"
          },
          {
            "name": "Total Revenue",
            "expression": "SUM ( FactTrip[Revenue] )",
            "formatString": "\"₹\"#,0",
            "displayFolder": "02 Value"
          },
          {
            "name": "Gross Amount",
            "expression": "SUM ( FactTrip[GrossAmount] )",
            "formatString": "\"₹\"#,0",
            "displayFolder": "02 Value"
          },
          {
            "name": "Net Revenue",
            "expression": "SUM ( FactTrip[NetRevenue] )",
            "formatString": "\"₹\"#,0",
            "displayFolder": "02 Value"
          },
          {
            "name": "Total Discount",
            "expression": "SUM ( FactTrip[DiscountAmount] )",
            "formatString": "\"₹\"#,0",
            "displayFolder": "02 Value"
          },
          {
            "name": "Total Commission",
            "expression": "SUM ( FactTrip[ChannelCommission] )",
            "formatString": "\"₹\"#,0",
            "displayFolder": "02 Value"
          },
          {
            "name": "Gross Margin",
            "expression": "SUM ( FactTrip[Trip Margin] )",
            "formatString": "\"₹\"#,0",
            "displayFolder": "02 Value"
          },
          {
            "name": "Revenue (Cr)",
            "expression": "DIVIDE ( [Total Revenue], 10000000 )",
            "formatString": "#,0.00\" Cr\"",
            "displayFolder": "02 Value"
          },
          {
            "name": "Net Revenue (Cr)",
            "expression": "DIVIDE ( [Net Revenue], 10000000 )",
            "formatString": "#,0.00\" Cr\"",
            "displayFolder": "02 Value"
          },
          {
            "name": "Avg Booking Value",
            "expression": "DIVIDE ( [Total Revenue], [Total Bookings] )",
            "formatString": "\"₹\"#,0",
            "displayFolder": "03 Averages"
          },
          {
            "name": "Revenue per Traveller",
            "expression": "DIVIDE ( [Total Revenue], [Total Travellers] )",
            "formatString": "\"₹\"#,0",
            "displayFolder": "03 Averages"
          },
          {
            "name": "Avg Trip Duration",
            "expression": "AVERAGE ( FactTrip[DurationDays] )",
            "formatString": "#,0.00",
            "displayFolder": "03 Averages"
          },
          {
            "name": "Avg Lead Time",
            "expression": "AVERAGE ( FactTrip[LeadTimeDays] )",
            "formatString": "#,0.00",
            "displayFolder": "03 Averages"
          },
          {
            "name": "Avg Satisfaction",
            "expression": "AVERAGE ( FactTrip[SatisfactionScore] )",
            "formatString": "#,0.00",
            "displayFolder": "03 Averages"
          },
          {
            "name": "Avg Party Size",
            "expression": "AVERAGE ( FactTrip[NumTravellers] )",
            "formatString": "#,0.00",
            "displayFolder": "03 Averages"
          },
          {
            "name": "Cancellation Rate %",
            "expression": "DIVIDE ( [Cancelled Bookings], [Total Bookings] )",
            "formatString": "0.0%",
            "displayFolder": "04 Ratios"
          },
          {
            "name": "Net Margin %",
            "expression": "DIVIDE ( [Net Revenue], [Total Revenue] )",
            "formatString": "0.0%",
            "displayFolder": "04 Ratios"
          },
          {
            "name": "Discount Rate %",
            "expression": "DIVIDE ( [Total Discount], [Gross Amount] )",
            "formatString": "0.0%",
            "displayFolder": "04 Ratios"
          },
          {
            "name": "Commission Rate %",
            "expression": "DIVIDE ( [Total Commission], [Total Revenue] )",
            "formatString": "0.0%",
            "displayFolder": "04 Ratios"
          },
          {
            "name": "Gross Margin %",
            "expression": "DIVIDE ( [Gross Margin], [Total Revenue] )",
            "formatString": "0.0%",
            "displayFolder": "04 Ratios"
          },
          {
            "name": "Promoter %",
            "expression": "DIVIDE (\n    CALCULATE ( [Total Bookings], FactTrip[Satisfaction Band] = \"Promoter (8-10)\" ),\n    CALCULATE ( [Total Bookings], NOT ISBLANK ( FactTrip[SatisfactionScore] ) )\n)",
            "formatString": "0.0%",
            "displayFolder": "04 Ratios"
          },
          {
            "name": "Revenue YTD",
            "expression": "TOTALYTD ( [Total Revenue], DimDate[FullDate] )",
            "formatString": "\"₹\"#,0",
            "displayFolder": "05 Time Intelligence"
          },
          {
            "name": "Revenue QTD",
            "expression": "TOTALQTD ( [Total Revenue], DimDate[FullDate] )",
            "formatString": "\"₹\"#,0",
            "displayFolder": "05 Time Intelligence"
          },
          {
            "name": "Revenue PY",
            "expression": "CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( DimDate[FullDate] ) )",
            "formatString": "\"₹\"#,0",
            "displayFolder": "05 Time Intelligence"
          },
          {
            "name": "Revenue YoY",
            "expression": "[Total Revenue] - [Revenue PY]",
            "formatString": "\"₹\"#,0",
            "displayFolder": "05 Time Intelligence"
          },
          {
            "name": "Revenue YoY %",
            "expression": "DIVIDE ( [Revenue YoY], [Revenue PY] )",
            "formatString": "0.0%",
            "displayFolder": "05 Time Intelligence"
          },
          {
            "name": "Revenue PM",
            "expression": "CALCULATE ( [Total Revenue], PREVIOUSMONTH ( DimDate[FullDate] ) )",
            "formatString": "\"₹\"#,0",
            "displayFolder": "05 Time Intelligence"
          },
          {
            "name": "Revenue MoM %",
            "expression": "DIVIDE ( [Total Revenue] - [Revenue PM], [Revenue PM] )",
            "formatString": "0.0%",
            "displayFolder": "05 Time Intelligence"
          },
          {
            "name": "Revenue 3M Moving Avg",
            "expression": "AVERAGEX (\n    DATESINPERIOD ( DimDate[FullDate], MAX ( DimDate[FullDate] ), -3, MONTH ),\n    CALCULATE ( [Total Revenue] )\n)",
            "formatString": "\"₹\"#,0",
            "displayFolder": "05 Time Intelligence",
            "description": "Three-month moving average, used to smooth the seasonal swing on the trend page."
          },
          {
            "name": "Revenue Rolling 12M",
            "expression": "CALCULATE (\n    [Total Revenue],\n    DATESINPERIOD ( DimDate[FullDate], MAX ( DimDate[FullDate] ), -12, MONTH )\n)",
            "formatString": "\"₹\"#,0",
            "displayFolder": "05 Time Intelligence"
          },
          {
            "name": "Running Total Revenue",
            "expression": "CALCULATE (\n    [Total Revenue],\n    FILTER (\n        ALLSELECTED ( DimDate[FullDate] ),\n        DimDate[FullDate] <= MAX ( DimDate[FullDate] )\n    )\n)",
            "formatString": "\"₹\"#,0",
            "displayFolder": "05 Time Intelligence"
          },
          {
            "name": "Bookings by Booking Date",
            "expression": "CALCULATE (\n    [Total Bookings],\n    USERELATIONSHIP ( FactTrip[BookingDateKey], DimDate[DateKey] )\n)",
            "formatString": "#,0",
            "displayFolder": "05 Time Intelligence",
            "description": "Uses the inactive booking-date relationship instead of the travel-date one."
          },
          {
            "name": "Destination Rank",
            "expression": "IF (\n    NOT ISBLANK ( [Total Revenue] ),\n    RANKX ( ALL ( DimDestination[DestinationName] ), [Total Revenue],, DESC, DENSE )\n)",
            "formatString": "0",
            "displayFolder": "06 Ranking"
          },
          {
            "name": "Revenue % of Total",
            "expression": "DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], ALLSELECTED ( DimDestination ) ) )",
            "formatString": "0.0%",
            "displayFolder": "06 Ranking"
          },
          {
            "name": "Top 5 Destinations Revenue",
            "expression": "CALCULATE (\n    [Total Revenue],\n    TOPN ( 5, ALL ( DimDestination[DestinationName] ), [Total Revenue], DESC )\n)",
            "formatString": "\"₹\"#,0",
            "displayFolder": "06 Ranking"
          },
          {
            "name": "Pareto Revenue %",
            "expression": "VAR CurrentRev = [Total Revenue]\nVAR AllDest =\n    ADDCOLUMNS ( ALLSELECTED ( DimDestination[DestinationName] ), \"@Rev\", [Total Revenue] )\nVAR CumRev =\n    SUMX ( FILTER ( AllDest, [@Rev] >= CurrentRev ), [@Rev] )\nVAR GrandTotal = SUMX ( AllDest, [@Rev] )\nRETURN\n    DIVIDE ( CumRev, GrandTotal )",
            "formatString": "0.0%",
            "displayFolder": "06 Ranking",
            "description": "Cumulative share of revenue, ordered from the largest destination down."
          },
          {
            "name": "Revenue Target",
            "expression": "VAR PriorYear = [Revenue PY]\nRETURN IF ( NOT ISBLANK ( PriorYear ), PriorYear * 1.15 )",
            "formatString": "\"₹\"#,0",
            "displayFolder": "07 Targets",
            "description": "Business target: 15% growth on the same period last year."
          },
          {
            "name": "Target Variance",
            "expression": "[Total Revenue] - [Revenue Target]",
            "formatString": "\"₹\"#,0",
            "displayFolder": "07 Targets"
          },
          {
            "name": "Target Achievement %",
            "expression": "DIVIDE ( [Total Revenue], [Revenue Target] )",
            "formatString": "0.0%",
            "displayFolder": "07 Targets"
          },
          {
            "name": "Revenue Trend Indicator",
            "expression": "VAR G = [Revenue YoY %]\nRETURN\n    SWITCH ( TRUE(),\n        ISBLANK ( G ), \"\",\n        G >= 0.15, \"▲ Ahead of target\",\n        G >= 0,    \"▲ Growing\",\n        \"▼ Declining\" )",
            "displayFolder": "07 Targets",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Satisfaction Status",
            "expression": "VAR S = [Avg Satisfaction]\nRETURN\n    SWITCH ( TRUE(),\n        ISBLANK ( S ), \"No ratings\",\n        S >= 7, \"Good\",\n        S >= 6, \"Acceptable\",\n        \"Needs attention\" )",
            "displayFolder": "07 Targets",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Revenue at Scenario Discount",
            "expression": "VAR Adj = SELECTEDVALUE ( 'Discount Scenario'[Discount %], 0 )\nRETURN\n    SUMX (\n        FactTrip,\n        FactTrip[GrossAmount] * ( 1 - Adj )\n    )",
            "formatString": "\"₹\"#,0",
            "displayFolder": "08 What-If",
            "description": "Revenue if every booking were sold at the scenario discount instead of its actual one."
          },
          {
            "name": "Scenario Revenue Impact",
            "expression": "[Revenue at Scenario Discount] - [Total Revenue]",
            "formatString": "\"₹\"#,0",
            "displayFolder": "08 What-If"
          },
          {
            "name": "Dynamic Title Destination",
            "expression": "\"Revenue performance - \" & \n    IF ( ISFILTERED ( DimDestination[DestinationName] ),\n        CONCATENATEX ( VALUES ( DimDestination[DestinationName] ), DimDestination[DestinationName], \", \" ),\n        \"all destinations\" )",
            "displayFolder": "09 Titles",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Dynamic Title Period",
            "expression": "VAR MinD = MIN ( DimDate[FullDate] )\nVAR MaxD = MAX ( DimDate[FullDate] )\nRETURN FORMAT ( MinD, \"dd MMM yyyy\" ) & \"  to  \" & FORMAT ( MaxD, \"dd MMM yyyy\" )",
            "displayFolder": "09 Titles",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          }
        ],
        "description": "Trip booking fact table at one row per booking, loaded from the cleaned dbo.FactTrip.",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
