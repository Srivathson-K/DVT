          },
          {
            "name": "PopularityIndex",
            "dataType": "double",
            "sourceColumn": "PopularityIndex",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "#,0.00"
          },
          {
            "name": "IsDomestic",
            "dataType": "boolean",
            "sourceColumn": "IsDomestic",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "isHidden": true
          },
          {
            "type": "calculated",
            "name": "Travel Scope",
            "dataType": "string",
            "expression": "IF ( DimDestination[IsDomestic], \"Domestic\", \"International\" )",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Destination Label",
            "dataType": "string",
            "expression": "DimDestination[DestinationName] & \" (\" & DimDestination[Country] & \")\"",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Cost Tier",
            "dataType": "string",
            "expression": "SWITCH ( TRUE(),\n    DimDestination[CostIndex] >= 1.8, \"1. Premium\",\n    DimDestination[CostIndex] >= 1.2, \"2. Upper Mid\",\n    DimDestination[CostIndex] >= 0.8, \"3. Mid\",\n    \"4. Value\" )",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "DimDestination",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(ServerName, DatabaseName),",
                "    dbo_DimDestination = Source{[Schema=\"dbo\",Item=\"DimDestination\"]}[Data],",
                "    #\"Changed Type\" = Table.TransformColumnTypes(dbo_DimDestination,{{\"Latitude\", type number}, {\"Longitude\", type number}}),",
                "    #\"Trimmed Text\" = Table.TransformColumns(#\"Changed Type\",{{\"DestinationName\", Text.Trim, type text}, {\"Country\", Text.Trim, type text}})",
                "in",
                "    #\"Trimmed Text\""
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Geography Hierarchy",
            "levels": [
              {
                "name": "Continent",
                "ordinal": 0,
                "column": "Continent"
              },
              {
                "name": "Country",
                "ordinal": 1,
                "column": "Country"
              },
              {
                "name": "DestinationName",
                "ordinal": 2,
                "column": "DestinationName"
              }
            ]
          }
        ],
        "description": "Destination master with geography for map visuals and a drill-down hierarchy.",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
