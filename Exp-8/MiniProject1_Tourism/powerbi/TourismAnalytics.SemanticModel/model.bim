            "dataType": "dateTime",
            "sourceColumn": "SignupDate",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "dd mmm yyyy"
          },
          {
            "name": "CustomerSegment",
            "dataType": "string",
            "sourceColumn": "CustomerSegment",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "LoyaltyTier",
            "dataType": "string",
            "sourceColumn": "LoyaltyTier",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "sortByColumn": "LoyaltyTierSort"
          },
          {
            "name": "IsRepeatCustomer",
            "dataType": "boolean",
            "sourceColumn": "IsRepeatCustomer",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Tenure Days",
            "dataType": "int64",
            "expression": "DATEDIFF ( DimTraveller[SignupDate], DATE ( 2026, 12, 31 ), DAY )",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "formatString": "0"
          },
          {
            "type": "calculated",
            "name": "Tenure Band",
            "dataType": "string",
            "expression": "SWITCH ( TRUE(),\n    DimTraveller[Tenure Days] >= 900, \"1. Long Standing (2y+)\",\n    DimTraveller[Tenure Days] >= 540, \"2. Established (1.5-2y)\",\n    DimTraveller[Tenure Days] >= 180, \"3. Growing (6m-1.5y)\",\n    \"4. New (<6m)\" )",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "LoyaltyTierSort",
            "dataType": "int64",
            "sourceColumn": "LoyaltyTierSort",
            "formatString": "0",
            "summarizeBy": "none",
            "isHidden": true,
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "DimTraveller",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(ServerName, DatabaseName),",
                "    dbo_DimTraveller = Source{[Schema=\"dbo\",Item=\"DimTraveller\"]}[Data],",
                "    #\"Changed Type\" = Table.TransformColumnTypes(dbo_DimTraveller,{{\"SignupDate\", type date}}),",
                "    #\"Cleaned Names\" = Table.TransformColumns(#\"Changed Type\",{{\"TravellerName\", each Text.Proper(Text.Trim(_)), type text}}),",
                "    #\"Added Tier Sort\" = Table.AddColumn(#\"Cleaned Names\", \"LoyaltyTierSort\", each if [LoyaltyTier] = \"Blue\" then 1 else if [LoyaltyTier] = \"Silver\" then 2 else if [LoyaltyTier] = \"Gold\" then 3 else if [LoyaltyTier] = \"Platinum\" then 4 else 5, Int64.Type)",
                "in",
                "    #\"Added Tier Sort\""
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Customer Hierarchy",
            "levels": [
              {
                "name": "CustomerSegment",
                "ordinal": 0,
                "column": "CustomerSegment"
              },
              {
                "name": "LoyaltyTier",
                "ordinal": 1,
                "column": "LoyaltyTier"
              },
              {
                "name": "TravellerName",
                "ordinal": 2,
                "column": "TravellerName"
              }
            ]
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
