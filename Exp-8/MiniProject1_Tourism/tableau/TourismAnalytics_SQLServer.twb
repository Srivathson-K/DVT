  <worksheet name='Discount Scenario'>
    <layout-options>
      <title>
        <formatted-text>
          <run fontsize='11' bold='true'>Actual vs scenario revenue by destination type</run>
        </formatted-text>
      </title>
    </layout-options>
    <table>
      <view>
        <datasources>
          <datasource caption='Tourism Analytics' name='federated.0tourism' />
          <datasource name='Parameters' />
        </datasources>
        <datasource-dependencies datasource='federated.0tourism'>
          <column datatype='string' name='[DestinationType]' role='dimension' type='nominal' />
          <column caption='Total Revenue' datatype='real' name='[Calculation_101]' role='measure' type='quantitative'>
            <calculation class='tableau' formula='SUM([Revenue])' />
          </column>
          <column caption='Scenario Revenue' datatype='real' name='[Calculation_301]' role='measure' type='quantitative'>
            <calculation class='tableau' formula='SUM([GrossAmount]) * (1 - [Parameters].[Parameter 2])' />
          </column>
          <column datatype='integer' name='[TripYear]' role='dimension' type='ordinal' />
          <column datatype='string' name='[TravelScope]' role='dimension' type='nominal' />
          <column datatype='string' name='[TripSeason]' role='dimension' type='nominal' />
          <column datatype='string' name='[ChannelType]' role='dimension' type='nominal' />
          <column-instance column='[DestinationType]' derivation='None' name='[none:DestinationType:nk]' pivot='key' type='nominal' />
          <column-instance column='[Calculation_101]' derivation='User' name='[usr:Calculation_101:qk]' pivot='key' type='quantitative' />
          <column-instance column='[Calculation_301]' derivation='User' name='[usr:Calculation_301:qk]' pivot='key' type='quantitative' />
          <column-instance column='[TripYear]' derivation='None' name='[none:TripYear:ok]' pivot='key' type='ordinal' />
          <column-instance column='[TravelScope]' derivation='None' name='[none:TravelScope:nk]' pivot='key' type='nominal' />
          <column-instance column='[TripSeason]' derivation='None' name='[none:TripSeason:nk]' pivot='key' type='nominal' />
          <column-instance column='[ChannelType]' derivation='None' name='[none:ChannelType:nk]' pivot='key' type='nominal' />
        </datasource-dependencies>
        <datasource-dependencies datasource='Parameters'>
          <column caption='Scenario Discount %' datatype='real' default-format='p0%' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='0.1'>
            <calculation class='tableau' formula='0.1' />
          </column>
        </datasource-dependencies>
        <filter class='categorical' column='[federated.0tourism].[none:TripYear:ok]'>
          <groupfilter function='level-members' level='[none:TripYear:ok]' user:ui-domain='database' user:ui-enumeration='all' user:ui-marker='enumerate' />
        </filter>
        <filter class='categorical' column='[federated.0tourism].[none:TravelScope:nk]'>
          <groupfilter function='level-members' level='[none:TravelScope:nk]' user:ui-domain='database' user:ui-enumeration='all' user:ui-marker='enumerate' />
        </filter>
        <filter class='categorical' column='[federated.0tourism].[none:TripSeason:nk]'>
          <groupfilter function='level-members' level='[none:TripSeason:nk]' user:ui-domain='database' user:ui-enumeration='all' user:ui-marker='enumerate' />
        </filter>
        <filter class='categorical' column='[federated.0tourism].[none:ChannelType:nk]'>
          <groupfilter function='level-members' level='[none:ChannelType:nk]' user:ui-domain='database' user:ui-enumeration='all' user:ui-marker='enumerate' />
        </filter>
        <sort class='computed' column='[federated.0tourism].[none:DestinationType:nk]' direction='DESC' using='[federated.0tourism].[usr:Calculation_101:qk]' />
        <slices>
          <column>[federated.0tourism].[none:TripYear:ok]</column>
          <column>[federated.0tourism].[none:TravelScope:nk]</column>
          <column>[federated.0tourism].[none:TripSeason:nk]</column>
          <column>[federated.0tourism].[none:ChannelType:nk]</column>
        </slices>
        <aggregation value='true' />
      </view>
      <style />
      <panes>
        <pane selection-relaxation-option='selection-relaxation-allow'>
          <view>
            <breakdown value='auto' />
          </view>
          <mark class='Bar' />
        </pane>
        <pane selection-relaxation-option='selection-relaxation-allow'>
          <view>
            <breakdown value='auto' />
          </view>
          <mark class='Bar' />
        </pane>
      </panes>
      <rows>[federated.0tourism].[none:DestinationType:nk]</rows>
      <cols>[federated.0tourism].[usr:Calculation_101:qk] + [federated.0tourism].[usr:Calculation_301:qk]</cols>
    </table>
