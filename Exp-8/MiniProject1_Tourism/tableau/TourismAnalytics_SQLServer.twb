      <column caption='Total Revenue' datatype='real' default-format='&quot;₹&quot;#,##0' name='[Calculation_101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue])' />
      </column>
      <column caption='Total Bookings' datatype='integer' default-format='#,##0' name='[Calculation_102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([TripID])' />
      </column>
      <column caption='Total Travellers' datatype='integer' default-format='#,##0' name='[Calculation_103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([NumTravellers])' />
      </column>
      <column caption='Avg Booking Value' datatype='real' default-format='&quot;₹&quot;#,##0' name='[Calculation_104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue]) / COUNT([TripID])' />
      </column>
      <column caption='Avg Satisfaction' datatype='real' default-format='#,##0.00' name='[Calculation_105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([SatisfactionScore])' />
      </column>
      <column caption='Cancellation Rate' datatype='real' default-format='p0.0%' name='[Calculation_106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [BookingStatus] = &quot;Cancelled&quot; THEN 1 ELSE 0 END) / COUNT([TripID])' />
      </column>
      <column caption='Net Margin %' datatype='real' default-format='p0.0%' name='[Calculation_107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([NetRevenue]) / SUM([Revenue])' />
      </column>
      <column caption='Discount Rate %' datatype='real' default-format='p0.0%' name='[Calculation_108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([DiscountAmount]) / SUM([GrossAmount])' />
      </column>
      <column caption='Revenue per Traveller' datatype='real' default-format='&quot;₹&quot;#,##0' name='[Calculation_109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue]) / SUM([NumTravellers])' />
      </column>
      <column caption='Destination Rank' datatype='real' default-format='#,##0' name='[Calculation_201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Revenue]))' />
      </column>
      <column caption='Top N Filter' datatype='boolean' name='[Calculation_202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Revenue])) &lt;= [Parameters].[Parameter 1]' />
      </column>
      <column caption='Revenue Moving Avg' datatype='real' default-format='&quot;₹&quot;#,##0' name='[Calculation_203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Revenue]), -2, 0)' />
      </column>
      <column caption='Running Revenue %' datatype='real' default-format='p0%' name='[Calculation_204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Revenue])) / TOTAL(SUM([Revenue]))' />
      </column>
      <column caption='Revenue YoY %' datatype='real' default-format='p0.0%' name='[Calculation_205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Revenue]) - LOOKUP(SUM([Revenue]), -1)) / ABS(LOOKUP(SUM([Revenue]), -1))' />
      </column>
      <column caption='Scenario Revenue' datatype='real' default-format='&quot;₹&quot;#,##0' name='[Calculation_301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([GrossAmount]) * (1 - [Parameters].[Parameter 2])' />
      </column>
      <column caption='Scenario Impact' datatype='real' default-format='&quot;₹&quot;#,##0' name='[Calculation_302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([GrossAmount]) * (1 - [Parameters].[Parameter 2])) - SUM([Revenue])' />
      </column>
      <column caption='Revenue Target' datatype='real' default-format='&quot;₹&quot;#,##0' name='[Calculation_303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM([Revenue]), -1) * (1 + [Parameters].[Parameter 3])' />
      </column>
      <column caption='Selected Measure' datatype='real' default-format='#,##0' name='[Calculation_304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]
  WHEN &quot;Revenue&quot;    THEN SUM([Revenue])
  WHEN &quot;Bookings&quot;   THEN COUNT([TripID])
  WHEN &quot;Travellers&quot; THEN SUM([NumTravellers])
END' />
      </column>
      <folders-common>
        <folder name='01 Trip Facts' role='dimensions'>
          <folder-item name='[BookingReference]' type='field' />
          <folder-item name='[BookingStatus]' type='field' />
          <folder-item name='[BookingWindow]' type='field' />
          <folder-item name='[TripLengthBand]' type='field' />
        </folder>
        <folder name='02 Destination' role='dimensions'>
          <folder-item name='[DestinationName]' type='field' />
          <folder-item name='[Country]' type='field' />
          <folder-item name='[Continent]' type='field' />
          <folder-item name='[Region]' type='field' />
          <folder-item name='[DestinationType]' type='field' />
          <folder-item name='[TravelScope]' type='field' />
        </folder>
        <folder name='03 Traveller' role='dimensions'>
          <folder-item name='[TravellerName]' type='field' />
          <folder-item name='[Gender]' type='field' />
          <folder-item name='[AgeBand]' type='field' />
          <folder-item name='[Nationality]' type='field' />
          <folder-item name='[CustomerSegment]' type='field' />
          <folder-item name='[LoyaltyTier]' type='field' />
        </folder>
      </folders-common>
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;India&quot;' />
      </semantic-values>
    </datasource>
  </datasources>
