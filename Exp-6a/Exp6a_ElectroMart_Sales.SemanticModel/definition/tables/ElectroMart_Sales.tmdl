	partition ElectroMart_Sales = m
		mode: import
		source =
				let
				    // Looks for the dataset in the usual places. If you keep it somewhere
				    // else, add that full path to this list - nothing else needs changing.
				    Candidates = {
				        "D:\DVT\Exp-6a\electromart_sales.csv",
				        "C:\DVT\Exp-6a\electromart_sales.csv",
				        "D:\DVT\6a to 7b\DVT\Exp-6a\electromart_sales.csv",
