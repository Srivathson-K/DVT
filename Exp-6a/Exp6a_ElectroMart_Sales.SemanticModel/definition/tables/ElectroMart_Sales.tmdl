				        "D:\DVT\DVT\exp6a\electromart_sales.csv",
				        "E:\DVT\exp6a\electromart_sales.csv",
				        "E:\DVT\DVT\exp6a\electromart_sales.csv"
				    },
				    Existing = List.Select(Candidates, each
				        try Binary.Length(File.Contents(_)) > 0 otherwise false),
				    DataFile = List.First(Existing, null),
				    Located = if DataFile = null then error "Could not find electromart_sales.csv. Open Transform Data and add its full path to the Candidates list in this query." else DataFile,
				    Source = Csv.Document(File.Contents(Located),[Delimiter=",", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
