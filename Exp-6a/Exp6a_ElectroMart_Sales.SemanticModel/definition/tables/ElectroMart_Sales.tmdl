table ElectroMart_Sales
	lineageTag: 249ed0bb-a432-f76b-3566-64779cd81590

	measure 'Total Sales' = SUM('ElectroMart_Sales'[Sales])
		formatString: \₹#,0
		lineageTag: 642d2942-b06c-e555-0206-f4ac6596576c

	measure 'Total Units' = SUM('ElectroMart_Sales'[UnitsSold])
		formatString: #,0
		lineageTag: 53bcb39a-c105-2e0e-4272-476c595eefa1

	measure 'Total Orders' = COUNTROWS('ElectroMart_Sales')
		formatString: #,0
		lineageTag: b3c3f58e-d2d7-d995-734f-613adc89d73a

	measure 'Average Order Value' = DIVIDE([Total Sales], [Total Orders])
		formatString: \₹#,0
		lineageTag: d985b5d9-90a5-f9cd-a6fb-e22379a6b194

